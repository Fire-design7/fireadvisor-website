# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and never committed.

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (API Keys page)
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (Domains tab) —
# onboarding@resend.dev only works for testing to your own account email.
RESEND_FROM_EMAIL="Fire Advisor <no-reply@mail.fireadvisor.eu>"
RESEND_OWNER_EMAIL=
# Set to "true" only once the sender domain has been verified for a while
# and has stable sending reputation. Until then, only the owner
# notification email is sent — customer confirmation stays off.
RESEND_CUSTOMER_CONFIRMATION=false

# Google Analytics (Admin > Data Streams > your stream > Measurement ID).
# Only loads in the browser after a visitor accepts the cookie consent
# banner — never fires without consent. Safe to leave empty if you don't
# want analytics yet.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Site lead capture (resource downloads on /resursi + the newsletter
# signup in the footer). Web app URL (ends in /exec) from the Apps
# Script bound to the Google Sheet that collects both — see
# D:\ПБ\site-leads-Code.gs for the script and setup instructions.
LEADS_SCRIPT_URL=
